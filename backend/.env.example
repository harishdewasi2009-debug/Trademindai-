# ── Upstox market data (the ONLY market-data provider) ──
UPSTOX_API_KEY=
UPSTOX_SECRET=
UPSTOX_REDIRECT_URI=https://<your-backend>/api/market/upstox/callback
CRON_SECRET=
ADMIN_ALERT_EMAIL=

# ── Registry / rate limits / streaming (all optional; defaults shown) ──
# Instrument master files (default: complete.json.gz, falling back to NSE+BSE+MCX). Comma-separated URLs override.
# UPSTOX_INSTRUMENT_FILES=
UPSTOX_RPS_LIMIT=20
UPSTOX_RPM_LIMIT=300
UPSTOX_R30M_LIMIT=1500
# Verify your plan's WebSocket subscription cap with Upstox and set it here.
UPSTOX_WS_MAX_SUBSCRIPTIONS=1000

# ── App ──
DATABASE_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
GOOGLE_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FRONTEND_URL=https://trademindai.co.in
GEMINI_API_KEY=

# ── Web Push notifications (optional; in-app + email work without) ──
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@trademindai.co.in
